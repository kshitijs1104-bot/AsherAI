# ---------------------------------------------------------------------------
# api-server environment
#
# Every REQUIRED var below is checked at boot in src/app.ts. A missing one is
# fatal before the port is bound, so a bad deploy fails visibly instead of
# coming up and answering 500 to everything.
#
# Real values live in Replit Secrets (or an untracked local .env), never here.
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------

# Clerk (https://dashboard.clerk.com > Configure > API Keys).
# BOTH are needed server-side. The publishable key is not optional here just
# because it is public: @clerk/express derives the Frontend API host from it,
# and without it clerkMiddleware throws on EVERY request — including
# /api/healthz — while the process still reports itself as running.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Postgres. lib/db throws on import if unset.
# Point this at a RESTRICTED role with SELECT/INSERT/UPDATE/DELETE on the app's
# own tables and nothing else — not CREATE, not DROP, not the owner role. Run
# schema pushes as the owner separately.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AES-256 key for OAuth connector tokens at rest (src/lib/crypto.ts).
# Exactly 32 bytes, hex or base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ROTATING THIS INVALIDATES EVERY STORED CONNECTOR TOKEN — users must reconnect.
CONNECTOR_ENCRYPTION_KEY=

# Comma-separated origins allowed to call this API. Feeds BOTH the CORS
# allowlist and the CSRF Origin check (src/middlewares/csrf.ts), so the two can
# never drift. Unset in production is fatal — refusing to start beats coming up
# with an open CORS policy. In development it falls back to the local Vite ports.
ALLOWED_ORIGIN=https://your-app.example.com

# Port to listen on. Injected by the platform in most deployments.
PORT=8080

# --- OPTIONAL, but each one silently disables a feature ----------------------

# Groq inference (https://console.groq.com). Without it every AI answer falls
# back to the canned "no model configured" response — the product still runs,
# it just cannot think. Logged at boot as a warning when unset.
GROQ_API_KEY=

# Public base URL of the frontend. Used to build the return URL after an OAuth
# connector round trip; without it callbacks redirect to a relative path.
FRONTEND_URL=https://your-app.example.com

# --- OPERATIONAL SWITCHES ---------------------------------------------------

# Kill switch. Set to on/true/1 and restart: every /api route answers 503 with
# a readable message, except /api/healthz and /api/readyz (which must keep
# answering so a deliberate maintenance window is not reported as an outage).
# An env var and not a DB row on purpose — this has to work when the database
# is the broken thing.
# VERA_MAINTENANCE_MODE=off

# Optional override for what users see during maintenance. Keep it honest and
# short; it is rendered as-is.
# VERA_MAINTENANCE_MESSAGE=

# pino level: fatal|error|warn|info|debug|trace. Defaults to info.
# Security events (rate-limit trips, blocked cross-origin writes, rejected
# uploads, attachment-ownership misses) are logged at warn — do not raise this
# above warn in production or they disappear.
# LOG_LEVEL=info

# Only flip to true once a payment method is actually live at
# console.groq.com/settings/billing AND the real per-model TPM numbers have
# been read off that account's Limits page into PAID_TIER_TPM_LIMIT_BY_MODEL
# in src/lib/groq.ts. Setting it early makes the token budgeter believe it has
# ~30x the headroom it really has, and every request 413s.
# GROQ_PAID_TIER=false

# Per-connector OAuth redirect URI overrides, if the derived one is wrong.
# e.g. GMAIL_REDIRECT_URI=https://your-app.example.com/api/connectors/gmail/callback
