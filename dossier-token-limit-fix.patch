+export const DOSSIER_SOURCE_CHAR_LIMIT = sourceCharBudget();
+export const DOSSIER_SOURCE_WORD_LIMIT = Math.max(1, Math.round(DOSSIER_SOURCE_CHAR_LIMIT / 5));
+
+export function dossierInputOverLimit(sourceText: string): boolean {
+  return sourceText.trim().length > DOSSIER_SOURCE_CHAR_LIMIT;
+}
+
+export function dossierInputOverLimitMessage(): string {
+  return `This document is over the size limit for dossier intake (about ${DOSSIER_SOURCE_WORD_LIMIT} words). Please shorten it to under ${DOSSIER_SOURCE_WORD_LIMIT} words and try again.`;
+}
+
+export function dossierInputWarningMessage(sourceText: string): string | null {
+  const trimmed = sourceText.trim();
+  if (!trimmed) return null;
+
+  const wordCount = trimmed.split(/\s+/).filter(Boolean).length;
+  if (wordCount >= Math.round(DOSSIER_SOURCE_WORD_LIMIT * 0.85)) {
+    return `This document is close to the size limit (~${DOSSIER_SOURCE_WORD_LIMIT} words). Please shorten it to under ${DOSSIER_SOURCE_WORD_LIMIT} words to save successfully.`;
+  }
+  return null;
+}
